# ============================================================
# 豆包工作每日签到 · 本地配置示例（.env 已被 .gitignore 排除，不会上传）
# 链路：launch 发现活动组 → detail 读取签到状态 → landing/checkin 领取并回查确认
# ============================================================

# ---------- 必填 ----------
# 浏览器登录 https://www.doubao.com 后的完整 Cookie（需含 sessionid 或 sessionid_ss）
DOUBAO_COOKIE="sessionid=xxxx; sessionid_ss=xxxx"

# ---------- 可选：客户端环境参数（一般用默认值即可，无需填写）----------
# DOUBAO_BASE_URL=https://www.doubao.com
# DOUBAO_CLIENT_VERSION=2.33.5
# DOUBAO_RUNTIME_VERSION=3.42.2
# DOUBAO_DEVICE_ID=
# DOUBAO_WEB_ID=
# DOUBAO_FINGERPRINT=

# ---------- 兼容旧单接口的兜底项（三步链路自动取路径，通常留空）----------
# DOUBAO_CHECKIN_URL=
# DOUBAO_CHECKIN_METHOD=POST
# DOUBAO_CHECKIN_BODY={}
# DOUBAO_EXTRA_HEADERS={"Referer":"https://www.doubao.com/chat/","Origin":"https://www.doubao.com"}

# ---------- 结果判定（接口改版时改这里，不用改代码）----------
# DOUBAO_SUCCESS_KEYWORDS=签到成功,领取成功,签到完成,success
# DOUBAO_ALREADY_KEYWORDS=已签到,已经签到,今日已领,重复签到,already

# ---------- 通知（可选，多个用英文逗号分隔）----------
# 支持：serverchan, wecom, telegram, bark, webhook
# DOUBAO_NOTIFY=bark
# DOUBAO_NOTIFY_ON_ALREADY=0
# BARK_URL=https://api.day.app/yourkey
# CUSTOM_WEBHOOK=
# WECOM_WEBHOOK=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SERVERCHAN_KEY=

# ---------- 调试 ----------
# DOUBAO_DEBUG=1
